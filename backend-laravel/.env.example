APP_NAME="Nohe Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://api.noheacademy.sa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Hostinger VPS MySQL Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nohe_academy_db
DB_USERNAME=nohe_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=nohe_cache_

# Laravel Sanctum Configuration
# When using SPA mode across domains:
SANCTUM_STATEFUL_DOMAINS=noheacademy.sa,www.noheacademy.sa,app.noheacademy.sa,localhost:3000
SANCTUM_EXPIRATION=1440

# Email - Resend API
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="support@noheacademy.sa"
MAIL_FROM_NAME="منصة نوح التعليمية"

# Video Delivery - Bunny.net Stream or Cloudflare Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_CDN_HOSTNAME=video.noheacademy.sa

# Saudi Payment Gateway (Moyasar / HyperPay)
MOYASAR_API_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# Backups - S3 / Cloudflare R2 / Backblaze B2 (spatie/laravel-backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=nohe-backups
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
